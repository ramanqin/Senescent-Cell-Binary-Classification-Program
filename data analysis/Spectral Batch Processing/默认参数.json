{
  "preprocess": {
    "crop_enabled": true,
    "ranges": "600-1800",
    "cosmic_enabled": true,
    "cosmic_window": 5,
    "cosmic_threshold": 12.0,
    "cosmic_max_width": 3,
    "cosmic_passes": 2,
    "resample_enabled": true,
    "resample_step": 3.0,
    "baseline_method": "ALS",
    "baseline_lambda": 100000.0,
    "baseline_p": 0.01,
    "baseline_iterations": 15,
    "baseline_poly_order": 5,
    "sg_enabled": true,
    "sg_window": 7,
    "sg_polyorder": 2,
    "sg_derivative": 0,
    "normalization": "向量归一化",
    "min_points": 20
  },
  "extensions": "txt,csv,dat",
  "recursive": true,
  "preserve_tree": true,
  "overwrite": false,
  "output_format": "txt",
  "output_suffix": "_预处理",
  "precision": 8
}
