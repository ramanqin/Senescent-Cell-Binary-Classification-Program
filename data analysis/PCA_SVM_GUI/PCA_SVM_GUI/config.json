{
  "input_dir": "D:/your_preprocessed_spectra",
  "output_dir": "D:/your_analysis_result",
  "negative_class": {
    "name": "年轻",
    "folders": ["年轻", "年轻细胞", "young"]
  },
  "positive_class": {
