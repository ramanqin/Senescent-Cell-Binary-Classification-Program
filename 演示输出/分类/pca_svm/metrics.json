{
  "model": "pca_svm",
  "independent_subjects": 10,
  "class_names": [
    "年轻",
    "衰老"
  ],
  "class_counts": [
    5,
    5
  ],
  "validation_method": "StratifiedKFold_fixed_parameters",
  "cv_splits": 5,
  "random_seed": 42,
  "parameter_search_performed": false,
  "fixed_parameters": {
    "pca_variance": 0.95,
    "kernel": "linear",
    "C": 0.01,
    "class_weight": "balanced"
  },
