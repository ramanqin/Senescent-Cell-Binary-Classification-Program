  "final_model_note": "全数据最终模型与折内评价模型分开；报告指标全部来自折外预测",
  "metrics": {
    "roc_auc": 1.0,
    "accuracy": 1.0,
    "balanced_accuracy": 1.0,
    "sensitivity_positive": 1.0,
    "specificity_negative": 1.0,
    "precision_positive": 1.0,
    "f1_positive": 1.0,
    "mcc": 1.0,
    "TN": 5,
    "FP": 0,
    "FN": 0,
    "TP": 5
  }
}